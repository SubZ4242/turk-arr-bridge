# Beispiel-Datei – diese ins Git pushen (ohne echte Werte)
# Kopiere sie als .env und trage deine echten Werte ein:
#   cp .env.example .env

SONARR_URL=http://YOUR_IP:PORT
SONARR_API_KEY=your_sonarr_api_key

RADARR_URL=http://YOUR_IP:PORT
RADARR_API_KEY=your_radarr_api_key

JACKETT_URL=http://YOUR_IP:PORT
JACKETT_API_KEY=your_jackett_api_key

UPSTREAM_TORZNAB_URL=http://YOUR_IP:PORT/api/v2.0/indexers/turktorrent/results/torznab/

QBIT_URL=http://YOUR_IP:PORT
QBIT_USER=your_qbit_username
QBIT_PASS=your_qbit_password

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
