version: "3.8"

# ============================================================
# Türk ARR Bridge - Portainer Stack (VORLAGE)
# ============================================================
# Kopiere diese Datei als portainer-stack.yml und passe die
# Werte an deine Umgebung an.
#
# Nach dem Deploy in Sonarr/Radarr die Indexer-URL ändern:
#   ALT:  http://<DEINE_IP>:<JACKETT_PORT>/api/v2.0/indexers/turktorrent/results/torznab/
#   NEU:  http://<DEINE_IP>:9696/torznab
# ============================================================

services:
  turk-arr-bridge:
    image: turk-arr-bridge:latest
    container_name: turk-arr-bridge
    restart: unless-stopped
    ports:
      - "9696:9696"
    environment:
      # Sonarr Konfiguration
      SONARR_URL: "http://<DEINE_IP>:<SONARR_PORT>"
      SONARR_API_KEY: "<DEIN_SONARR_API_KEY>"
      
      # Radarr Konfiguration
      RADARR_URL: "http://<DEINE_IP>:<RADARR_PORT>"
      RADARR_API_KEY: "<DEIN_RADARR_API_KEY>"
      
      # Jackett Konfiguration
      JACKETT_URL: "http://<DEINE_IP>:<JACKETT_PORT>"
      JACKETT_API_KEY: "<DEIN_JACKETT_API_KEY>"
      
      # Upstream: Das echte Jackett/TürkTorrent Torznab-Endpoint
      UPSTREAM_TORZNAB_URL: "http://<DEINE_IP>:<JACKETT_PORT>/api/v2.0/indexers/turktorrent/results/torznab/"
      
      # Bridge Einstellungen
      BRIDGE_PORT: "9696"
      CACHE_TTL_SECONDS: "300"
      LOG_LEVEL: "INFO"
    
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9696/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
